# Copia este archivo como `.env.development` (local) o configura las vars en Render (producción).
# Nunca subas archivos `.env*` reales al repositorio.

# ── MySQL ──────────────────────────────────────
# Local:
bdduser=root
bddpassword=TU_PASSWORD
bddname=posdb
bddhost=localhost
bddport=3306
bddprovider=mysql
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/posdb"

# Aiven (producción) — TLS cifrado; Prisma acepta la CA de Aiven:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=accept_invalid_certs"
# No uses ssl-mode=REQUIRED ni sslaccept=strict (falla en Render).

# ── JWT ────────────────────────────────────────
# En producción: secreto aleatorio ≥ 24 caracteres (Render puede generarlo)
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_aleatorio"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App ────────────────────────────────────────
# En producción: URL pública del frontend en Vercel (CORS y enlaces de reset)
FRONTEND_URL="http://localhost:3000"
# Varias orígenes separadas por coma (opcional)
# FRONTEND_URLS="https://pos.vercel.app,https://www.tudominio.com"
PORT=3001
NODE_ENV=development

# Swagger solo en desarrollo (o FORCE con ENABLE_SWAGGER=true)
# ENABLE_SWAGGER=true

# ── Correo (Resend) ────────────────────────────
# https://resend.com — sin API key los correos se simulan en logs
RESEND_API_KEY=
RESEND_FROM="POS Honduras <onboarding@resend.dev>"

# ── Seed de producción (solo al correr npm run prisma:seed:prod) ──
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=ClaveSeguraMin10!
# ADMIN_NAME=Administrador
# BUSINESS_NAME=Mi Negocio
