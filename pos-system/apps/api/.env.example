# Copia este archivo como `.env.development` (o `.env` / `.env.production`) y completa los valores.
# Nunca subas archivos `.env*` reales al repositorio.

# MySQL
bdduser=root
bddpassword=TU_PASSWORD
bddname=posdb
bddhost=localhost
bddport=3306
bddprovider=mysql
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/posdb"

# JWT — usa un secreto largo y único en producción (mín. 24 caracteres)
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_aleatorio"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
# En producción: URL pública del frontend (CORS y enlaces de reset)
FRONTEND_URL="http://localhost:3000"
# Varias orígenes separadas por coma (opcional)
# FRONTEND_URLS="https://pos.tudominio.com,https://www.pos.tudominio.com"
PORT=3001
NODE_ENV=development

# Swagger solo en desarrollo (o FORCE con ENABLE_SWAGGER=true)
# ENABLE_SWAGGER=true

# Correo con Resend (https://resend.com)
# Sin API key, los correos se simulan en los logs del API
RESEND_API_KEY=
RESEND_FROM="POS Honduras <onboarding@resend.dev>"
