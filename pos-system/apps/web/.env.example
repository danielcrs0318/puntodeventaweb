# Desarrollo: el proxy de Vite reenvía /api y /uploads al backend.
# VITE_PORT=3000
# VITE_API_TARGET=http://localhost:3001
# VITE_PREVIEW_PORT=4173

# Producción (build estático sin proxy):
# - Opción A (recomendada): nginx sirve la SPA y hace proxy de /api y /uploads → deja vacío
# - Opción B: API en otro dominio
# VITE_API_BASE_URL=https://api.tudominio.com
