# Ejemplo de reverse proxy para producción (nginx).
# Ajusta rutas de `root` (build del frontend) y el upstream del API.

upstream pos_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name pos.tudominio.com;
    # Después de obtener certificado: return 301 https://$host$request_uri;

    client_max_body_size 8m;

    root /var/www/pos-web/dist;
    index index.html;

    location /api/ {
        proxy_pass http://pos_api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location /uploads/ {
        proxy_pass http://pos_api/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        expires 7d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
